# Cloudflare Workers static assets: custom response headers.
# Authored 2026-10-28 during the site quality audit.
#
# Default (no _headers) was "Cache-Control: public, max-age=0, must-revalidate"
# on every asset, so browsers re-validated CSS/JS/images on every navigation.
# These files have no content hash, so a short max-age plus
# stale-while-revalidate is used instead of a year-long immutable cache.
#
# Strict-Transport-Security is set to a deliberately short max-age (1 day).
# Raise it to 31536000 only after a week of clean HTTPS-only traffic, because
# browsers remember HSTS for the whole max-age and it cannot be taken back.
#
# Content-Security-Policy is shipped as Report-Only first: the 25 game pages
# contain large inline <script> blocks, so an enforcing policy would break every
# game on day one. Watch the console reports, then decide.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Strict-Transport-Security: max-age=86400
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://www.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com; font-src 'self' data:; connect-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google; frame-src https://googleads.g.doubleclick.net https://www.googletagmanager.com https://ep2.adtrafficquality.google https://www.google.com; object-src 'none'; base-uri 'self'

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/games/_shared.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/games/fit.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/thumbs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
