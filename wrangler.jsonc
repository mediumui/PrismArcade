{
  // Cloudflare Workers + Assets 配置 —— Prism Arcade 静态站
  // 部署：npx wrangler deploy
  "name": "prism-arcade",
  "compatibility_date": "2025-10-01",
  "assets": {
    // 静态资源目录 = 仓库根（index.html / css / games / 404.html 都在这里）
    "directory": "./",
    // 关键修复：请求不匹配任何静态文件时，返回根目录的 404.html 并带 404 状态码
    "not_found_handling": "404-page"
    // 如果你后续写了自定义 Worker 脚本（如边缘中间件），再加：
    // "main": "./worker.js"
  }
}
